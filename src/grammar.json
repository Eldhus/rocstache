{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "rocstache",
  "rules": {
    "template": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "pragma"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "content"
              },
              {
                "type": "SYMBOL",
                "name": "comment"
              },
              {
                "type": "SYMBOL",
                "name": "set_delimiter"
              },
              {
                "type": "SYMBOL",
                "name": "section_open"
              },
              {
                "type": "SYMBOL",
                "name": "inverted_open"
              },
              {
                "type": "SYMBOL",
                "name": "conditional_open"
              },
              {
                "type": "SYMBOL",
                "name": "section_close"
              },
              {
                "type": "SYMBOL",
                "name": "partial"
              },
              {
                "type": "SYMBOL",
                "name": "raw_tag"
              },
              {
                "type": "SYMBOL",
                "name": "tag"
              }
            ]
          }
        }
      ]
    },
    "pragma": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{{%"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "ALIAS",
              "content": {
                "type": "TOKEN",
                "content": {
                  "type": "PREC",
                  "value": -1,
                  "content": {
                    "type": "PATTERN",
                    "value": "([^%]|%[^}]|%\\}[^}])+"
                  }
                }
              },
              "named": true,
              "value": "roc_code"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "%}}"
        }
      ]
    },
    "content": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "([^{]|\\{[^{])+"
        }
      }
    },
    "comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "comment_open"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "ALIAS",
              "content": {
                "type": "TOKEN",
                "content": {
                  "type": "PREC",
                  "value": -1,
                  "content": {
                    "type": "PATTERN",
                    "value": "([^}]|\\}[^}])+"
                  }
                }
              },
              "named": true,
              "value": "comment_text"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "}}"
        }
      ]
    },
    "comment_open": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "{{"
          },
          {
            "type": "PATTERN",
            "value": "\\s*"
          },
          {
            "type": "STRING",
            "value": "!"
          }
        ]
      }
    },
    "set_delimiter": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "{{="
          },
          {
            "type": "PATTERN",
            "value": "[^=]*"
          },
          {
            "type": "STRING",
            "value": "=}}"
          }
        ]
      }
    },
    "section_open": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "section_open_delim"
        },
        {
          "type": "SYMBOL",
          "name": "path"
        },
        {
          "type": "STRING",
          "value": "}}"
        }
      ]
    },
    "section_open_delim": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "{{"
          },
          {
            "type": "PATTERN",
            "value": "\\s*"
          },
          {
            "type": "STRING",
            "value": "#"
          }
        ]
      }
    },
    "inverted_open": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "inverted_open_delim"
        },
        {
          "type": "SYMBOL",
          "name": "path"
        },
        {
          "type": "STRING",
          "value": "}}"
        }
      ]
    },
    "inverted_open_delim": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "{{"
          },
          {
            "type": "PATTERN",
            "value": "\\s*"
          },
          {
            "type": "STRING",
            "value": "^"
          }
        ]
      }
    },
    "conditional_open": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "conditional_open_delim"
        },
        {
          "type": "SYMBOL",
          "name": "path"
        },
        {
          "type": "STRING",
          "value": "}}"
        }
      ]
    },
    "conditional_open_delim": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "{{"
          },
          {
            "type": "PATTERN",
            "value": "\\s*"
          },
          {
            "type": "STRING",
            "value": "?"
          }
        ]
      }
    },
    "section_close": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "section_close_delim"
        },
        {
          "type": "SYMBOL",
          "name": "path"
        },
        {
          "type": "STRING",
          "value": "}}"
        }
      ]
    },
    "section_close_delim": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "{{"
          },
          {
            "type": "PATTERN",
            "value": "\\s*"
          },
          {
            "type": "STRING",
            "value": "/"
          }
        ]
      }
    },
    "partial": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "partial_delim"
        },
        {
          "type": "SYMBOL",
          "name": "partial_name"
        },
        {
          "type": "STRING",
          "value": "}}"
        }
      ]
    },
    "partial_delim": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "{{"
          },
          {
            "type": "PATTERN",
            "value": "\\s*"
          },
          {
            "type": "STRING",
            "value": ">"
          }
        ]
      }
    },
    "partial_name": {
      "type": "PATTERN",
      "value": "[A-Z][A-Za-z0-9]*"
    },
    "raw_tag": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "{{{"
            },
            {
              "type": "SYMBOL",
              "name": "expression"
            },
            {
              "type": "STRING",
              "value": "}}}"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "raw_delim"
            },
            {
              "type": "SYMBOL",
              "name": "expression"
            },
            {
              "type": "STRING",
              "value": "}}"
            }
          ]
        }
      ]
    },
    "raw_delim": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "{{"
          },
          {
            "type": "PATTERN",
            "value": "\\s*"
          },
          {
            "type": "STRING",
            "value": "&"
          }
        ]
      }
    },
    "tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{{"
        },
        {
          "type": "SYMBOL",
          "name": "expression"
        },
        {
          "type": "STRING",
          "value": "}}"
        }
      ]
    },
    "expression": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "path"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "|"
              },
              {
                "type": "SYMBOL",
                "name": "formatter"
              }
            ]
          }
        }
      ]
    },
    "path": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "this"
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "SYMBOL",
                      "name": "root"
                    },
                    {
                      "type": "REPEAT1",
                      "content": {
                        "type": "SYMBOL",
                        "name": "parent"
                      }
                    }
                  ]
                },
                {
                  "type": "BLANK"
                }
              ]
            },
            {
              "type": "SYMBOL",
              "name": "identifier"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SEQ",
                "members": [
                  {
                    "type": "IMMEDIATE_TOKEN",
                    "content": {
                      "type": "STRING",
                      "value": "."
                    }
                  },
                  {
                    "type": "ALIAS",
                    "content": {
                      "type": "IMMEDIATE_TOKEN",
                      "content": {
                        "type": "PATTERN",
                        "value": "[a-z][a-z0-9_]*"
                      }
                    },
                    "named": true,
                    "value": "identifier"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    "this": {
      "type": "STRING",
      "value": "."
    },
    "root": {
      "type": "STRING",
      "value": "@"
    },
    "parent": {
      "type": "STRING",
      "value": "../"
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[a-z][a-z0-9_]*"
    },
    "formatter": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "formatter_name"
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "argument"
          }
        }
      ]
    },
    "formatter_name": {
      "type": "PATTERN",
      "value": "([A-Z][A-Za-z0-9]*\\.)*[a-z][a-z0-9_]*"
    },
    "argument": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "path"
        }
      ]
    },
    "string": {
      "type": "PATTERN",
      "value": "\"([^\"\\\\]|\\\\.)*\""
    },
    "number": {
      "type": "PATTERN",
      "value": "-?[0-9][A-Za-z0-9_.]*"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}